---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.jsx';
import LanguageToggle from './LanguageToggle.jsx';
---

<header>
	<nav>
		<a href="/" class="logo" aria-label="Home">
			<div class="logo-box">
				<span class="logo-bracket">&lt;</span>
				<span class="logo-text">SL</span>
				<span class="logo-bracket">/&gt;</span>
			</div>
		</a>
		<div class="internal-links">
			<HeaderLink href="/"><span class="lang-en">Me</span><span class="lang-nl">Mezelf</span></HeaderLink>
			<HeaderLink href="/projects"><span class="lang-en">Work</span><span class="lang-nl">Werk</span></HeaderLink>
			<HeaderLink href="/contact"><span class="lang-en">Contact</span><span class="lang-nl">Contact</span></HeaderLink>
		</div>
		<div class="header-controls">
			<ThemeToggle client:load />
			<LanguageToggle client:load />
		</div>
	</nav>
</header>

<style>
	header {
		margin: 1rem auto;
		padding: 0 1.25em;
		background: rgba(245, 242, 235, 0.88);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		box-shadow: 0 4px 30px rgba(0, 0, 0, 0.08);
		border: 1px solid rgba(0, 0, 0, 0.06);
		border-radius: 50px;
		max-width: 900px;
		width: calc(100% - 2rem);
		box-sizing: border-box;
		z-index: 1000;
	}
	:global(.dark) header {
		background: rgba(13, 17, 23, 0.75);
		border-color: rgba(255, 255, 255, 0.1);
		box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4);
	}
	nav {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		width: 100%;
		box-sizing: border-box;
	}
	.logo {
		display: flex;
		align-items: center;
		flex-shrink: 0;
		text-decoration: none;
	}
	.logo-box {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.2rem 0.5rem;
		transition: transform 0.2s ease;
	}
	.logo-bracket {
		color: var(--accent);
		font-family: 'Courier New', monospace;
		font-size: 1.6rem;
		font-weight: 900;
	}
	.logo-text {
		color: rgb(var(--black));
		font-family: 'Courier New', monospace;
		font-size: 1.6rem;
		font-weight: 900;
		letter-spacing: 2px;
		margin: 0 4px;
	}
	:global(.dark) .logo-text {
		color: white;
	}
	.logo:hover .logo-box {
		transform: scale(1.08);
	}
	.internal-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(0.75rem, 1.8vw, 1.4rem);
		white-space: nowrap;
	}
	nav a {
		padding: 0.6em clamp(0.4em, 1vw, 0.8em);
		color: rgb(var(--black));
		border-bottom: 2px solid transparent;
		font-size: 0.98rem;
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.2s ease, border-color 0.2s ease;
	}
	:global(.dark) nav a {
		color: #f8fafc;
	}
	nav a:hover,
	nav a.active {
		color: var(--accent);
	}
	nav a.active {
		border-bottom-color: var(--accent);
	}
	.header-controls {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		flex-shrink: 0;
		margin-left: auto;
	}
	.header-controls :global(button) {
		margin-left: 0 !important;
	}
	@media (min-width: 841px) {
		.internal-links {
			position: absolute;
			left: 50%;
			transform: translateX(-50%);
		}
	}
	@media (max-width: 840px) {
		header {
			margin: 0.6rem auto;
			padding: 0.6rem 1rem;
			border-radius: 24px;
			width: calc(100% - 1.25rem);
		}
		nav {
			display: grid;
			grid-template-columns: auto 1fr;
			grid-template-rows: auto auto;
			gap: 0.4rem 0;
		}
		.logo {
			grid-column: 1;
			grid-row: 1;
		}
		.logo-bracket,
		.logo-text {
			font-size: 1.35rem;
		}
		.logo-text {
			letter-spacing: 1px;
			margin: 0 2px;
		}
		.header-controls {
			grid-column: 2;
			grid-row: 1;
			justify-self: end;
		}
		.internal-links {
			grid-column: 1 / -1;
			grid-row: 2;
			display: flex;
			justify-content: space-around;
			width: 100%;
			margin: 0;
			gap: 0.35rem;
			padding-top: 0.45rem;
			border-top: 1px solid rgba(120, 120, 120, 0.15);
		}
		:global(.dark) .internal-links {
			border-top-color: rgba(255, 255, 255, 0.1);
		}
		nav a {
			padding: 0.4rem 0.55rem;
			font-size: 0.92rem;
			text-align: center;
		}
	}
</style>
