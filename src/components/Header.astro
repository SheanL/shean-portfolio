---
import { CONTACT_EMAIL, GITHUB_URL } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.jsx';
import LanguageToggle from './LanguageToggle.jsx';
---

<header>
	<nav>
		<a href="/" class="logo" aria-label="Home">
			<div class="logo-box">
				<span class="logo-bracket">&lt;</span>
				<span class="logo-text">SL</span>
				<span class="logo-bracket">/&gt;</span>
			</div>
		</a>
		<div class="internal-links">
			<HeaderLink href="/"><span class="lang-en">Me</span><span class="lang-nl">Mezelf</span></HeaderLink>
			<HeaderLink href="/projects"><span class="lang-en">Work</span><span class="lang-nl">Werk</span></HeaderLink>
			<HeaderLink href="/contact"><span class="lang-en">Contact</span><span class="lang-nl">Contact</span></HeaderLink>
		</div>
		<div class="social-links" style="align-items: center;">
			<ThemeToggle client:load />
			<LanguageToggle client:load />
			<a href={`mailto:${CONTACT_EMAIL}`} target="_blank">
				<span class="sr-only">Send an email</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
					<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
					<polyline points="22,6 12,13 2,6"></polyline>
				</svg>
			</a>
			<a href="https://www.linkedin.com/in/shean-looghe/" target="_blank">
				<span class="sr-only">LinkedIn Profile</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
					<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
					<rect x="2" y="9" width="4" height="12"></rect>
					<circle cx="4" cy="4" r="2"></circle>
				</svg>
			</a>
			<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
				<span class="sr-only">GitHub Profile</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28">
					<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
				</svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 1rem auto;
		padding: 0 1.25em;
		background: rgba(255, 255, 255, 0.85);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		box-shadow: 0 4px 30px rgba(0, 0, 0, 0.08);
		border: 1px solid rgba(0, 0, 0, 0.06);
		border-radius: 50px;
		max-width: 900px;
		width: calc(100% - 2rem);
		box-sizing: border-box;
		z-index: 1000;
	}
	:global(.dark) header {
		background: rgba(13, 17, 23, 0.75);
		border: 1px solid rgba(255, 255, 255, 0.1);
		box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4);
	}
	.logo {
		display: flex;
		align-items: center;
		text-decoration: none;
		flex-shrink: 0;
	}
	.logo-box {
		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform 0.2s ease;
		padding: 0.2rem 0.5rem;
	}
	.logo-bracket {
		color: var(--accent);
		font-family: 'Courier New', monospace;
		font-size: 1.6rem;
		font-weight: 900;
	}
	.logo-text {
		color: rgb(var(--black));
		font-family: 'Courier New', monospace;
		font-weight: 900;
		font-size: 1.6rem;
		letter-spacing: 2px;
		margin: 0 4px;
	}
	:global(.dark) .logo-text {
		color: white;
	}
	.logo:hover .logo-box {
		transform: scale(1.08);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		width: 100%;
		box-sizing: border-box;
	}
	.internal-links {
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto;
		gap: clamp(0.75rem, 1.8vw, 1.4rem);
		white-space: nowrap;
	}
	nav a {
		padding: 0.6em clamp(0.4em, 1vw, 0.8em);
		font-size: 0.98rem;
		white-space: nowrap;
		color: rgb(var(--black));
		border-bottom: 2px solid transparent;
		text-decoration: none;
		transition: color 0.2s ease, border-color 0.2s ease;
	}
	nav a:hover {
		color: var(--accent);
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
		color: var(--accent);
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		flex-wrap: nowrap;
		flex-shrink: 0;
	}
	.social-links :global(button) {
		margin-left: 0 !important;
	}
	.social-links a {
		display: flex;
		align-items: center;
		padding: 0.2rem;
		color: rgb(var(--black));
		transition: color 0.2s ease;
	}
	.social-links a:hover {
		color: var(--accent);
	}
	:global(.dark) .social-links a {
		color: #ffffff !important;
		opacity: 0.95;
	}
	:global(.dark) .social-links a:hover {
		color: #60a5fa !important;
		opacity: 1;
	}

	/* Tablet & GSM Modus (<= 840px): Schakelt over naar 2-rijen layout zodat GEEN enkel icoon buiten de balk valt */
	@media (max-width: 840px) {
		header {
			margin: 0.6rem auto;
			padding: 0.6rem 1rem;
			border-radius: 24px;
			width: calc(100% - 1.25rem);
		}
		nav {
			display: grid;
			grid-template-columns: auto 1fr;
			grid-template-rows: auto auto;
			align-items: center;
			gap: 0.4rem 0;
		}
		.logo {
			grid-column: 1;
			grid-row: 1;
			justify-self: start;
		}
		.logo-bracket,
		.logo-text {
			font-size: 1.35rem;
		}
		.logo-text {
			letter-spacing: 1px;
			margin: 0 2px;
		}
		/* Iconen altijd rechts bovenaan, volledig omsloten door de header achtergrond */
		.social-links {
			grid-column: 2;
			grid-row: 1;
			justify-self: end;
			display: flex !important;
			align-items: center;
			gap: 0.5rem;
		}
		.social-links a {
			display: flex !important;
			padding: 0.2rem;
		}
		.social-links svg {
			width: 22px;
			height: 22px;
		}
		/* Navigatietekst eronder: over de volle breedte met ademruimte */
		.internal-links {
			grid-column: 1 / -1;
			grid-row: 2;
			display: flex;
			justify-content: space-around;
			align-items: center;
			width: 100%;
			margin: 0;
			gap: 0.35rem;
			padding-top: 0.45rem;
			border-top: 1px solid rgba(120, 120, 120, 0.15);
			margin-top: 0.25rem;
		}
		:global(.dark) .internal-links {
			border-top-color: rgba(255, 255, 255, 0.1);
		}
		nav a {
			padding: 0.4rem 0.55rem;
			font-size: 0.92rem;
			text-align: center;
		}
	}
</style>
